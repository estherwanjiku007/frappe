{
  "name": "Frappe Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "frappe",
  "workspaceFolder": "/workspace",
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "extensions": [
    "ms-python.python",
    "ms-python.vscode-pylance"
  ],
  "forwardPorts": [8000]
}
